PROJECT_NAME=psico-agenda
ENVIRONMENT=development
# Supabase (Project Settings > API). SUPABASE_KEY = service_role key (secreta, solo backend).
# El esquema se crea ejecutando supabase/migrations/*.sql en el SQL Editor.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=
BACKEND_CORS_ORIGINS=http://localhost:5173

# Google Calendar: JSON de la Service Account.
GOOGLE_CREDENTIALS_FILE=./credentials.json
# Opcional: token OAuth2 de usuario; si existe tiene prioridad (necesario para Meet en Gmail normal)
# GOOGLE_OAUTH_TOKEN_FILE=./token.json
# Correo/ID del calendario del psicólogo, compartido con el client_email de la Service Account
GOOGLE_CALENDAR_ID=primary

# Agenda
TIMEZONE=America/Mexico_City
WORKDAY_START=09:00
WORKDAY_END=18:00
SLOT_DURATION_MINUTES=50

# Psicólogo que se crea al iniciar si la tabla está vacía
PSYCHOLOGIST_NAME=
PSYCHOLOGIST_EMAIL=

# Acceso al panel: usuarios de Supabase Auth con el email de un psicólogo registrado.
# Para dar acceso a otros correos, agrégalos aquí separados por comas.
ADMIN_EMAILS=

# WhatsApp Cloud API (Meta) — ver backend/README.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Lo inventas tú; el mismo valor va en Meta > WhatsApp > Configuration > Webhook > Verify token
WHATSAPP_VERIFY_TOKEN=
# Meta > App settings > Basic > App secret (valida la firma de cada webhook)
WHATSAPP_APP_SECRET=
WHATSAPP_REMINDER_TEMPLATE=recordatorio_cita
WHATSAPP_TEMPLATE_LANGUAGE=es_MX

# Recordatorios: ~24 h antes de cada cita pendiente, solo entre las horas indicadas
REMINDERS_ENABLED=true
REMINDER_HOURS_BEFORE=24
REMINDER_INTERVAL_MINUTES=30
REMINDER_SEND_FROM=08:00
REMINDER_SEND_UNTIL=21:00
# Minutos antes de la cita en que el panel marca "Sin confirmar" si sigue pendiente
UNCONFIRMED_ALERT_MINUTES=60

# Reserva segura (portal del paciente)
BOOKING_RATE_LIMIT=3/15minutes
VERIFY_RATE_LIMIT=10/15minutes
MAX_ACTIVE_APPOINTMENTS_PER_PHONE=2
HOLD_MINUTES=10
# Firma de los códigos OTP. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
OTP_SECRET=
# Plantilla de autenticación aprobada en Meta (es_MX)
OTP_TEMPLATE=codigo_verificacion
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_MAX_PER_PHONE_PER_HOUR=3
# Cloudflare Turnstile (secret key). Vacío = no se exige captcha
TURNSTILE_SECRET_KEY=
