# URL base de la API. En desarrollo, /api/v1 usa el proxy de Vite hacia http://localhost:8000
VITE_API_URL=/api/v1

# Supabase Auth (login del panel). Project Settings > API Keys.
# Usa la llave PUBLISHABLE (sb_publishable_...) o la anon: son públicas por diseño.
# NUNCA pongas aquí la secret / service_role: todo lo que empieza con VITE_ termina en el navegador.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile (site key, pública). Vacío = sin captcha (desarrollo)
VITE_TURNSTILE_SITE_KEY=
